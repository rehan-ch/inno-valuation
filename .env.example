# Copy to .env and adjust. bin/setup does this for you on a fresh clone.
# .env is never committed.

# --- Backend ---
# Runtime environment: development, test or production.
ENVIRONMENT=development
# Main database (sync SQLAlchemy with psycopg 3).
DATABASE_URL=postgresql+psycopg://innovaluation:innovaluation@localhost:5440/innovaluation
# Server used by the test suite to create a throwaway database per run.
# The suite creates and drops its own database on this server.
TEST_DATABASE_URL=postgresql+psycopg://innovaluation:innovaluation@localhost:5440/postgres
# Celery broker and result backend.
REDIS_URL=redis://localhost:6390/0
# Secret used to sign session JWTs. Use a long random value in production.
SECRET_KEY=change-me
# Origin of the Next.js frontend, used for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Filled in later phases (left empty is fine for Phase 0).
# Anthropic API key for the AI touchpoints (Phase 3 onward).
ANTHROPIC_API_KEY=
# Google OAuth client for sign in (Phase 2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend API key and sender for emails (Phase 2).
RESEND_API_KEY=
EMAIL_FROM=InnoValuation <no-reply@example.com>

# --- Frontend ---
# Base URL of the backend API as seen from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
