#!/bin/bash
# Runs only the pure scoring engine tests. Keep this fast (under 10 seconds).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ ! -d "$ROOT/backend/tests/scoring" ]; then
  echo "No scoring tests yet (backend/tests/scoring). Nothing to run."
  exit 0
fi
command -v uv >/dev/null 2>&1 || { echo "uv is required (https://docs.astral.sh/uv/)" >&2; exit 1; }
cd "$ROOT/backend"
uv run pytest tests/scoring -q
