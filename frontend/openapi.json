        "description": "A user's role inside one organisation.\n\nPlatform staff are not a role here (``User.is_platform_admin``), and a consultant is\nnever a member (``ConsultantGrant``).",
        "enum": [
          "owner",
          "admin",
          "member",
          "committee",
          "investor"
        ],
        "title": "MembershipRole",
        "type": "string"
